@page "/registrieren"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using LernCockpit.Components.Models
@using MudBlazor
@using MudBlazor.Components
@using LernCockpit.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager NavManager

<PageTitle>Registrieren - LernCockpit</PageTitle>

<MudGrid Justify="Justify.Center" Class="mt-8">
    <MudItem xs="12" sm="10" md="7">
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5" Align="Align.Center">Registrierung</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                
                <MudTextField T="string" Label="Name" 
                              HelperText="Max. 8 Zeichen"
                              @bind-Value="model.Username"
                              Validation="@(new Func<string, Task<IEnumerable<string>>>(CheckUsername))"
                              Immediate="true"
                              DebounceInterval="500"/>
                
                <MudTextField T="string" Label="Email" 
                              Class="mt-3" HelperText="Nur gültige Email-Adressen."
                              @bind-Value="model.Email"
                              Validation="@(new Func<string, Task<IEnumerable<string>>>(CheckEmail))"
                              Immediate="true"
                              DebounceInterval="500"/>
                
                <MudTextField T="string" Label="Passwort" 
                              HelperText="Wähle ein starkes Passwort" 
                              Class="mt-3"
                              @bind-Value="model.Password"
                              Validation="@(new Func<string, IEnumerable<string>>(CheckPassword))"
                              InputType="InputType.Password"
                              Immediate="true"/>
                
                <MudTextField T="string" Label="Passwort wiederholen" 
                              HelperText="Wiederhole das Passwort" 
                              Class="mt-3"
                              @bind-Value="model.Password2"
                              Validation="@(new Func<string, IEnumerable<string>>(CheckPassword2))"
                              InputType="InputType.Password"
                              Immediate="true"/>
                
                @if (success)
                {
                    <MudAlert Severity="Severity.Success" Class="mt-4" Dense="true">
                        ✓ Erfolgreich registriert! Du kannst dich jetzt anmelden.
                    </MudAlert>
                }
                
                @if (!string.IsNullOrEmpty(generalError))
                {
                    <MudAlert Severity="Severity.Error" Class="mt-4" Dense="true">
                        @generalError
                    </MudAlert>
                }
            </MudCardContent>
            
            <MudCardActions Class="pb-4 px-4">
                <MudButton ButtonType="ButtonType.Button" 
                           Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           FullWidth="true"
                           Size="Size.Large"
                           OnClick="OnSubmit">
                    Registrieren
                </MudButton>
            </MudCardActions>
            
            <MudDivider />
            
            <MudCardActions Class="d-flex justify-center py-3">
                <MudText Typo="Typo.body2">Schon registriert?</MudText>
                <MudLink Href="/login" Color="Color.Primary" Class="ms-2">
                    <strong>Jetzt anmelden</strong>
                </MudLink>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    RegisterAccountForm model = new RegisterAccountForm();
    bool success;
    string generalError = "";

    public class RegisterAccountForm
    {
        public string Username { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public string Password2 { get; set; } = "";
    }
    
    private async Task<IEnumerable<string>> CheckUsername(string username)
    {
        if (string.IsNullOrWhiteSpace(username)) return new[] { "Bitte gib einen Namen ein" };
        if (username.Length > 8) return new[] { "Maximal 8 Zeichen erlaubt" };

        try
        {
            using var db = DbFactory.CreateDbContext();
            var vergeben = await db.Users.AnyAsync(u => u.Username == username);
            if (vergeben) return new[] { "Name ist bereits vergeben" };
        }
        catch
        {
            return new[] { "Verbindungsfehler zur Datenbank" };
        }

        return Enumerable.Empty<string>();
    }

    private async Task<IEnumerable<string>> CheckEmail(string email)
    {
        if (string.IsNullOrWhiteSpace(email)) return new[] { "Email erforderlich" };
        if (!email.Contains("@") || !email.Contains(".")) return new[] { "Ungültige Email" };

        try
        {
            using var db = DbFactory.CreateDbContext();
            var vergeben = await db.Users.AnyAsync(u => u.Email == email);
            if (vergeben) return new[] { "Email wird bereits verwendet" };
        }
        catch 
        {
            return new[] { "Fehler bei Prüfung" };
        }
        return Enumerable.Empty<string>();
    }

    private IEnumerable<string> CheckPassword(string password)
    {
        if (string.IsNullOrWhiteSpace(password)) return new[] { "Passwort erforderlich" };
        if (password.Length < 8) return new[] { "Mindestens 8 Zeichen" };
        return Enumerable.Empty<string>();
    }

    private IEnumerable<string> CheckPassword2(string password2)
    {
        if (string.IsNullOrWhiteSpace(password2)) return new[] { "Wiederholung erforderlich" };
        if (password2 != model.Password) return new[] { "Passwörter stimmen nicht überein" };
        return Enumerable.Empty<string>();
    }
    
    private async Task OnSubmit()
    {
        // Validierung durchführen
        var nameCheck = await CheckUsername(model.Username);
        var mailCheck = await CheckEmail(model.Email);
        var pwCheck = CheckPassword(model.Password);
        var pw2Check = CheckPassword2(model.Password2);
        
        if (nameCheck.Any() || mailCheck.Any() || pwCheck.Any() || pw2Check.Any())
        {
            generalError = "Bitte korrigiere die rot markierten Felder.";
            return;
        }

        try
        {
            using var db = DbFactory.CreateDbContext();
            var newUser = new User
            {
                Username = model.Username,
                Email = model.Email,
                // ich muss passwort noch verschlüsseln
                PasswordHash = model.Password, 
                CreatedAt = DateTime.Now
            };
            
            db.Users.Add(newUser);
            await db.SaveChangesAsync();
            
            success = true;
            model = new RegisterAccountForm();
            generalError = "";

            StateHasChanged();
            
            await Task.Delay(2000);
               
            NavManager.NavigateTo("/login");
            
            
        }
        catch (Exception ex)
        {
            generalError = $"Datenbankfehler: {ex.Message}";
            Console.WriteLine($"Registrierungsfehler: {ex}");
        }
    }
}