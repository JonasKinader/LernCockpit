@page "/Datenschutz"
@using MudBlazor

<PageTitle>Datenschutz - LernCockpit</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">
    <MudPaper Class="pa-6" Elevation="3">
        <MudText Typo="Typo.h4" Class="mb-4">Datenschutzerklärung</MudText>
        
        <MudText Typo="Typo.h6" Class="mt-4">1. Datenschutz auf einen Blick</MudText>
        <MudText Typo="Typo.body1" Class="mb-3">
            Diese Datenschutzerklärung klärt Sie über die Art, den Umfang und Zweck der Verarbeitung 
            von personenbezogenen Daten innerhalb unserer Anwendung auf.
        </MudText>
        
        <MudText Typo="Typo.h6" Class="mt-4">2. Verantwortlicher</MudText>
        <MudText Typo="Typo.body1" Class="mb-3">
            Max Mustermann<br />
            Musterstraße 123<br />
            12345 Musterstadt<br />
            E-Mail: info@lerncockpit.de
        </MudText>
        
        <MudText Typo="Typo.h6" Class="mt-4">3. Erhobene Daten</MudText>
        <MudText Typo="Typo.body1" Class="mb-3">
            Bei der Registrierung werden folgende Daten erhoben:<br />
            - Benutzername<br />
            - E-Mail-Adresse<br />
            - Passwort (verschlüsselt gespeichert)
        </MudText>
        
        <MudText Typo="Typo.h6" Class="mt-4">4. Zweck der Datenverarbeitung</MudText>
        <MudText Typo="Typo.body1" Class="mb-3">
            Die Daten werden ausschließlich zur Bereitstellung der Lernplattform verwendet.
        </MudText>
        
        <MudText Typo="Typo.h6" Class="mt-4">5. Ihre Rechte</MudText>
        <MudText Typo="Typo.body1" Class="mb-3">
            Sie haben das Recht auf Auskunft, Berichtigung, Löschung und Einschränkung der Verarbeitung 
            Ihrer personenbezogenen Daten.
        </MudText>
        
        <MudDivider Class="my-4" />
        
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            Dies ist ein Platzhalter. Bitte mit einer vollständigen Datenschutzerklärung ersetzen.
        </MudText>
    </MudPaper>
</MudContainer>